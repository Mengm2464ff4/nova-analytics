# ===== Database =====
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nova_analytics?schema=public"

# ===== Redis =====
REDIS_URL="redis://localhost:6379"

# ===== Server =====
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000,http://localhost:5000"

# ===== JWT =====
JWT_SECRET="replace-with-random-48-byte-hex"
JWT_EXPIRES_IN="7d"

# ===== Tracking =====
TRACKING_SALT="replace-with-random-32-byte-hex"

# ===== Email (Resend) =====
RESEND_API_KEY="re_your_key_here"
EMAIL_FROM="Nova Analytics <noreply@yourdomain.com>"
FRONTEND_URL="http://localhost:3000"

# ===== SMTP (optional) =====
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@nova-analytics.local"