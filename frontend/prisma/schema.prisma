generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

generator client_frontend {
  provider = "prisma-client-js"
  output   = "../../frontend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  reports       Report[]
  sessions      Session[]
  sites         Site[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

model Site {
  id          String          @id @default(cuid())
  userId      String
  name        String
  domain      String
  trackingKey String          @unique @default(cuid())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  events      Event[]
  sessions    SessionRecord[]
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgets     Widget[]

  @@index([userId])
  @@map("sites")
}

model Event {
  id        String   @id @default(cuid())
  siteId    String
  type      String
  path      String
  referrer  String?
  country   String?
  city      String?
  device    String?
  browser   String?
  os        String?
  ipHash    String
  visitorId String?
  metadata  Json?
  createdAt DateTime @default(now())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([siteId, path])
  @@index([siteId, type])
  @@map("events")
}

model SessionRecord {
  id              String    @id @default(cuid())
  siteId          String
  visitorId       String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  pageviews       Int       @default(0)
  country         String?
  device          String?
  site            Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, startedAt])
  @@map("session_records")
}

model Widget {
  id       String @id @default(cuid())
  siteId   String
  type     String
  title    String
  config   Json
  position Int    @default(0)
  width    Int    @default(6)
  height   Int    @default(2)
  site     Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("widgets")
}

model Report {
  id         String    @id @default(cuid())
  userId     String
  name       String
  schedule   String
  recipients String[]
  format     String
  lastSentAt DateTime?
  nextRunAt  DateTime
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextRunAt])
  @@map("reports")
}

enum Role {
  USER
  ADMIN
  VIEWER
}
